{
  "manifest_version": 3,
  "name": "Tuổi Thơ M4 Browser Control",
  "version": "0.2.0",
  "description": "Local-only browser policy evaluation and parent-created URL blocking.",
  "permissions": ["nativeMessaging", "declarativeNetRequest", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "web_accessible_resources": [
    { "resources": ["blocked.html"], "matches": ["<all_urls>"] }
  ],
  "content_scripts": [
    { "matches": ["*://*.youtube.com/*", "*://youtu.be/*"], "js": ["content/youtube.js"], "run_at": "document_idle" },
    { "matches": ["*://*.tiktok.com/*"], "js": ["content/tiktok.js"], "run_at": "document_idle" }
  ]
}